# ============================================
# Mariscos Quiroa — Variables de entorno
# ============================================
# Copia este archivo a .env y completa los valores.
# NUNCA subas .env a git (ya está en .gitignore).

# Base de datos PostgreSQL (Neon, Supabase, Vercel Postgres, etc.)
# Formato: postgresql://usuario:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://usuario:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require"

# NextAuth.js (generar con: openssl rand -hex 32)
NEXTAUTH_SECRET="tu-secret-aqui-generado-con-openssl-rand-hex-32"

# URL del sitio (en desarrollo: http://localhost:3000, en producción: https://mariscosquiroa.com)
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# WhatsApp Business Cloud API (Meta)
# ============================================
# Dejar vacío si todavía no se configuró. El webhook responderá 503 y el sitio seguirá funcionando.
# Ver docs/WHATSAPP_SETUP.md para guía paso a paso.

# Token permanente de acceso a la Graph API (App → WhatsApp → API Setup)
WHATSAPP_ACCESS_TOKEN=""

# ID del número de teléfono verificado (App → WhatsApp → Phone numbers)
WHATSAPP_PHONE_NUMBER_ID=""

# ID de la WhatsApp Business Account (App → WhatsApp → WhatsApp Business Account)
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# Secreto de la App (App → Settings → Basic → App Secret)
# Se usa para validar la firma X-Hub-Signature-256 del webhook
WHATSAPP_APP_SECRET=""

# Token de verificación del webhook (lo inventas tú — debe coincidir con lo que pongas en Meta)
WHATSAPP_VERIFY_TOKEN="mariscos_quiroa_webhook_verify_token_cambiar"

# Versión de la API (default v20.0)
WHATSAPP_API_VERSION="v20.0"


# ============================================
# Agente de IA — vía proxy centralizado de LOGAN OS
# ============================================
# Mariscos Quiroa NO maneja API keys de IA propias. Llama al proxy /api/llm de
# LOGAN OS, que centraliza las keys y la cascada de proveedores (gratis primero
# -> de pago al final). Arquitectura: DEC-LOGAN-006 + modelo reseller.

# URL del proxy LLM de LOGAN (default: producción en logancorp.vercel.app)
LOGAN_LLM_URL="https://logancorp.vercel.app/api/llm"

# Secreto compartido para autenticar con el proxy de LOGAN.
# Debe coincidir con el LOGAN_LLM_SECRET configurado en el Vercel de logan-app.
LOGAN_LLM_SECRET=""



# ============================================
# Messenger + Instagram (Meta Messenger Platform)
# ============================================
# El agente de IA también atiende Facebook Messenger e Instagram Direct.
# Ambos usan la Página de Facebook (Instagram debe estar vinculado a ella).
# Ver docs/MESSENGER_SETUP.md para la guía de configuración en Meta.

# Token de la Página de Facebook (sirve para Messenger e Instagram vinculado)
# Se obtiene en la app de Meta → Messenger/Instagram → Generar token de la página.
MESSENGER_PAGE_ACCESS_TOKEN=""

# Token de verificación del webhook (lo inventas tú; debe coincidir con Meta).
MESSENGER_VERIFY_TOKEN="mariscos_quiroa_messenger_verify_cambiar"

# Nota: WHATSAPP_APP_SECRET se reutiliza para validar la firma del webhook
# (es la misma app de Meta), no se necesita una variable aparte.
